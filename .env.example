# Copy to `.env` and adjust for your machine. Never commit real secrets.
# Config loads this file automatically when present (see mobilewright.config.ts).

# --- Android ---
# ANDROID_DEVICE_NAME=Pixel 8
# ANDROID_DEVICE_TYPE=emulator
# ANDROID_APP_PATH=apps/android/my-demo-app.apk

# --- iOS ---
# IOS_DEVICE_NAME=iPhone 16
# IOS_DEVICE_TYPE=simulator
# IOS_APP_PATH=apps/ios/my-demo-app-simulator.zip

# Skip install when the app is already on the device (useful for faster local loops).
# SKIP_APP_INSTALL=1

# Screen recording: off | on | retain-on-failure (default: off — slows devices).
# MW_VIDEO=off

# Set automatically on GitHub Actions; enables forbidOnly and retries.
# CI=1
